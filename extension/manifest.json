{
  "manifest_version": 3,
  "name": "Chatshouse Admin Monitor",
  "version": "1.0.0",
  "description": "Monitors operator activity and provides AI-powered quality scoring",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatshouse.com/*",
    "https://api.chatshouse.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatshouse.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatshouse Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.css", "overlay.js"],
      "matches": ["https://chatshouse.com/*"]
    }
  ]
}
